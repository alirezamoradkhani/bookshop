# Application
APP_NAME=bookshop
DEBUG=true

# Development infrastructure used by docker-compose.yml
DATABASE_URL=postgresql+asyncpg://admin:123456@postgres:5432/mydb
REDIS_URL=redis://redis:6379/0
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
MEILI_URL=http://meilisearch:7700
MEILI_MASTER_KEY=replace-with-a-development-key

# Authentication — replace before any shared or public deployment
JWT_SECRET=replace-with-a-long-random-development-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
